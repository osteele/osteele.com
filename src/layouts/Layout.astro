---
import { ViewTransitions } from "astro:transitions";
import DarkModeToggle from "@/components/DarkModeToggle";
import MobileMenu from "@/components/MobileMenu";
import Search from "@/components/Search";
import { FaFlickr, FaGithub, FaLinkedin } from "react-icons/fa";
import { SiBluesky, SiMastodon, SiObservable } from "react-icons/si";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = "Oliver Steele",
	description = "Making, teaching, writing, playing",
	ogImage = "https://osteele.com/images/og-image.png",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>
            {title === "Oliver Steele" ? title : `${title} | Oliver Steele`}
        </title>
        <meta name="description" content={description} />
        <meta
            property="og:title"
            content={title === "Oliver Steele"
                ? title
                : `${title} | Oliver Steele`}
        />
        <meta property="og:description" content={description} />
        <meta property="og:url" content="https://osteele.com" />
        <meta property="og:site_name" content="Oliver Steele" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="robots" content="index, follow" />
        <meta name="author" content="Oliver Steele" />
        <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
        <ViewTransitions />
        <script is:inline>
            (function() {
                const theme = localStorage.getItem("theme");
                if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                    document.documentElement.classList.add("dark");
                }
            })();
        </script>
    </head>
    <body class="flex flex-col min-h-full">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
            Skip to main content
        </a>
        <nav class="family-nav family-nav-fixed" aria-label="Oliver Steele sites">
            <a href="/" aria-current="page">osteele.com</a>
            <span class="family-nav-separator" aria-hidden="true">/</span>
            <a href="https://notes.osteele.com">notes</a>
            <span class="family-nav-separator" aria-hidden="true">/</span>
            <a href="https://photos.osteele.com">photos</a>
            <span class="family-nav-separator" aria-hidden="true">/</span>
            <a href="https://viz.osteele.com">viz</a>
            <span class="family-nav-separator" aria-hidden="true">/</span>
            <a href="https://papers.osteele.com">papers</a>
        </nav>
        <header
            class="site-header fixed w-full bg-white/80 dark:bg-black/80 backdrop-blur-sm z-[100] border-b border-gray-200 dark:border-gray-800"
            transition:persist
        >
            <nav
                class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
            >
                <a href="/" class="text-xl font-semibold"> Oliver Steele </a>
                <div class="flex items-center gap-6">
                    <div class="hidden md:flex items-center gap-5" id="desktop-nav">
                        <a
                            href="/about"
                            data-nav="/about"
                            class="nav-link hover:text-[#D9482A] dark:hover:text-[#FF8A6B]"
                            >About</a
                        >
                        <a
                            href="/projects"
                            data-nav="/projects,/products,/topics"
                            class="nav-link hover:text-[#D9482A] dark:hover:text-[#FF8A6B]"
                            >Work</a
                        >
                        <a
                            href="/software"
                            data-nav="/software"
                            class="nav-link hover:text-[#D9482A] dark:hover:text-[#FF8A6B]"
                            >Software</a
                        >
                        <a
                            href="/teaching/courses"
                            data-nav="/teaching,/teaching-materials"
                            class="nav-link hover:text-[#D9482A] dark:hover:text-[#FF8A6B]"
                            >Teaching</a
                        >
                    </div>
                    <Search client:load />
                    <DarkModeToggle client:load />
                    <MobileMenu client:load />
                </div>
            </nav>
        </header>

        <main id="main-content" class="site-main">
            <slot />
        </main>

        <footer class="mt-auto border-t border-gray-200 dark:border-gray-800" transition:persist>
            <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
                <div class="flex flex-col items-center gap-4">
                    <div class="flex items-center gap-6">
                        <a
                            href="https://github.com/osteele"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            aria-label="GitHub"
                        >
                            <FaGithub className="w-6 h-6" />
                        </a>
                        <a
                            href="https://observablehq.com/@osteele"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            title="Observable: @osteele"
                            aria-label="Observable"
                        >
                            <SiObservable className="w-6 h-6" />
                        </a>
                        <a
                            href="https://bsky.app/profile/osteele.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            title="Bluesky: @osteele.com"
                            aria-label="Bluesky"
                        >
                            <SiBluesky className="w-6 h-6" />
                        </a>
                        <a
                            href="https://mastodon.social/@steele"
                            target="_blank"
                            rel="me noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            title="Mastodon: @steele@osteele.com"
                            aria-label="Mastodon"
                        >
                            <SiMastodon className="w-6 h-6" />
                        </a>
                        <a
                            href="https://www.linkedin.com/in/osteele"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            aria-label="LinkedIn"
                        >
                            <FaLinkedin className="w-6 h-6" />
                        </a>
                        <a
                            href="https://www.flickr.com/photos/osteele"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                            aria-label="Flickr"
                        >
                            <FaFlickr className="w-6 h-6" />
                        </a>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        © 2003-{new Date().getFullYear()} by Oliver Steele. All
                        rights reserved. <a href="/contact" class="hover:text-gray-700 dark:hover:text-gray-300 underline">Contact</a>
                        · <a href="/colophon" class="hover:text-gray-700 dark:hover:text-gray-300 underline">Colophon</a>
                    </p>
                </div>
            </div>
        </footer>

        <script>
            function updateActiveNav() {
                const path = location.pathname;
                document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
                    const navPaths = link.dataset.nav?.split(",") ?? [];
                    const isActive = navPaths.some((nav) => path === nav || path.startsWith(nav + "/"));
                    if (isActive) {
                        link.classList.add("font-semibold", "underline", "underline-offset-4");
                        link.setAttribute("aria-current", "page");
                    } else {
                        link.classList.remove("font-semibold", "underline", "underline-offset-4");
                        link.removeAttribute("aria-current");
                    }
                });
            }
            updateActiveNav();
            document.addEventListener("astro:after-swap", updateActiveNav);
        </script>
    </body>
</html>

<style is:global>
    .family-nav {
        display: flex;
        align-items: center;
        gap: 20px;
        min-height: 34px;
        padding: 8px 24px;
        box-sizing: border-box;
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 12px;
        line-height: 1.4;
        background: #1e2530;
        color: #8b95a5;
    }

    .family-nav-fixed {
        position: fixed;
        inset: 0 0 auto;
        z-index: 110;
    }

    .family-nav a {
        color: #8b95a5;
        text-decoration: none;
        transition: color 0.15s;
        touch-action: manipulation;
        white-space: nowrap;
    }

    .family-nav a:hover {
        color: #fff;
    }

    .family-nav a[aria-current="page"] {
        color: #fff;
        font-weight: 600;
    }

    .family-nav-separator {
        color: #3a4250;
    }

    .site-header {
        top: 34px;
    }

    .site-main {
        padding-top: 98px;
    }

    @media (max-width: 560px) {
        .family-nav {
            gap: 10px;
            padding-inline: 16px;
        }

        .family-nav a {
            min-height: 18px;
            display: inline-flex;
            align-items: center;
        }
    }
</style>
