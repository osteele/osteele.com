---
const destination = "https://photos.osteele.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destination} />
    <title>Oliver Steele Photography</title>
  </head>
  <body>
    <p>Continue to <a href={destination}>Oliver Steele Photography</a>.</p>
    <script is:inline>
      window.location.replace("https://photos.osteele.com/");
    </script>
  </body>
</html>
