---
import { projectsData } from "@/data/projects";
import { FaArrowRight, FaBrain, FaCamera, FaChalkboardTeacher, FaCode } from "react-icons/fa";
import Layout from "../layouts/Layout.astro";

const byName = new Map(projectsData.projects.map((p) => [p.name, p]));

type FeaturedCard = {
	title: string;
	description: string;
	href: string;
	label: string;
	thumbnail: string;
	external?: boolean;
};

const project = (name: string, label: string): FeaturedCard | null => {
	const p = byName.get(name);
	if (!p?.thumbnail) return null;
	return {
		title: p.name,
		description: p.description,
		href: p.website || p.repo || "#",
		label,
		thumbnail: p.thumbnail,
		external: true,
	};
};

const featured: FeaturedCard[] = [
	{
		title: "Nest Learning Thermostat",
		description: "Initial server software and engineering leadership for the connected home product.",
		href: "/products/nest-learning-thermostat",
		label: "Industry",
		thumbnail: "https://images.osteele.com/products/nest-learning-thermostat.webp",
	},
	{
		title: "Apple Dylan",
		description:
			"Technical leadership for Apple's Common Lisp and Smalltalk-inspired language and development environment.",
		href: "/products/apple-dylan",
		label: "Legacy impact",
		thumbnail: "https://images.osteele.com/products/apple-dylan.webp",
	},
	project("Weft", "Open-source infrastructure"),
].filter((c): c is FeaturedCard => c !== null);

const pathways = [
	{
		Icon: FaBrain,
		title: "Research",
		body: "Language models, interpretability, uncertainty, and systems performance.",
		links: [
			{ label: "Papers", href: "https://papers.osteele.com/" },
			{ label: "Visualizations", href: "https://viz.osteele.com/" },
		],
	},
	{
		Icon: FaCode,
		title: "Software",
		body: "Applications, developer tools, libraries, and research infrastructure.",
		links: [
			{ label: "Software index", href: "/software" },
			{ label: "Selected work", href: "/work" },
		],
	},
	{
		Icon: FaChalkboardTeacher,
		title: "Teaching",
		body: "Courses, project-based curricula, technical notes, and learning tools.",
		links: [
			{ label: "Teaching", href: "/teaching" },
			{ label: "Notes", href: "https://notes.osteele.com/" },
		],
	},
	{
		Icon: FaCamera,
		title: "Creative practice",
		body: "Photography, interactive systems, physical computing, and making.",
		links: [
			{ label: "Photos", href: "https://photos.osteele.com/" },
			{ label: "Art and making", href: "https://osteele.notion.site/art" },
		],
	},
];
---

<Layout
	title="Oliver Steele"
	description="Oliver Steele - Software engineer, researcher, educator, and maker"
>
	<div class="mx-auto max-w-4xl px-6 pt-7 pb-10 sm:pb-12">
		<!-- Hero -->
		<h1
			class="mb-5 font-serif text-4xl font-bold leading-none text-center sm:mb-7 sm:text-left sm:text-5xl sm:-ml-[0.04em] lg:text-6xl"
			transition:name="hero-heading"
		>
			Oliver Steele
		</h1>

		<div class="flex flex-col items-stretch gap-5 sm:flex-row sm:gap-7 lg:gap-8">
			<!-- Illustration -->
			<figure class="flex-shrink-0 mx-auto sm:mx-0 flex flex-col">
				<div
					class="w-44 h-44 overflow-hidden rounded-lg sm:w-56 sm:h-56 lg:w-64 lg:h-64"
				>
					<img
						src="/images/banner-illustration.jpg"
						alt="Oliver Steele running in a hamster wheel beside a desk"
						class="w-full h-full object-cover object-center"
						transition:name="hero-image"
					/>
				</div>
				<figcaption
					class="mt-2 text-center text-sm italic leading-tight text-gray-500 dark:text-gray-400"
				>
					&ldquo;Human in the loop&rdquo;
				</figcaption>
			</figure>

			<!-- Lead + primary routes -->
			<div class="flex-1 flex flex-col text-center sm:text-left">
				<p
					class="max-w-2xl text-base leading-7 text-gray-700 dark:text-gray-300 sm:text-lg sm:leading-8"
				>
					Software engineer, researcher, and educator building tools for learning, creativity, and understanding
					complex systems.
				</p>
				<div
					class="mt-auto pt-7 flex flex-wrap gap-3 justify-center sm:justify-start"
				>
					<a
						href="/work"
						class="inline-flex items-center rounded-lg bg-[#FF6B4A] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#E85530] transition-colors"
					>
						Explore work
					</a>
					<a
						href="/about"
						class="inline-flex items-center rounded-lg border border-gray-300 dark:border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-800 dark:text-gray-200 hover:border-gray-400 dark:hover:border-gray-600 transition-colors"
					>
						About
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="max-w-4xl mx-auto px-6 pb-16 space-y-16">
		<section class="border-y border-gray-200 py-5 text-sm leading-6 text-gray-600 dark:border-gray-800 dark:text-gray-400">
			Currently a graduate student at <a href="https://www.sigs.tsinghua.edu.cn/en/" class="link">Tsinghua SIGS</a>.
			Previous work includes Apple, Nest, NYU Shanghai, and Olin College.
		</section>

		<!-- Selected Work -->
		<section>
			<div class="mb-6 flex flex-col items-start gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
				<h2 class="font-serif text-2xl sm:text-3xl font-semibold leading-tight">
					Selected Work
				</h2>
				<a
					href="/work"
					class="link shrink-0 text-sm no-underline hover:underline"
				>
					All work
				</a>
			</div>
			<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
				{
					featured.map((card, index) => (
						<a
							href={card.href}
							target={card.external ? "_blank" : undefined}
							rel={card.external ? "noopener noreferrer" : undefined}
							class:list={[
								"group relative overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#FF6B4A]/40 hover:shadow-md dark:border-gray-800 dark:bg-gray-900",
								index === 0 ? "md:col-span-2 md:grid md:grid-cols-[1.15fr_1fr]" : "flex flex-col",
							]}
						>
							<div
								class:list={[
									"overflow-hidden bg-gray-100 dark:bg-gray-800",
									index === 0 ? "aspect-[16/10] md:aspect-auto md:min-h-64" : "aspect-[16/10]",
								]}
							>
								<img
									src={card.thumbnail}
									alt=""
									loading="lazy"
									class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
								/>
							</div>
							<div class="flex flex-1 flex-col p-5">
								<p class="text-xs font-semibold text-[#D9482A] dark:text-[#FF8A6B]">
									{card.label}
								</p>
								<h3 class="mt-1 font-semibold leading-snug text-gray-900 dark:text-gray-100">
									{card.title}
								</h3>
								<p class="mt-1.5 flex-grow text-sm leading-6 text-gray-600 dark:text-gray-400">
									{card.description}
								</p>
								<span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-[#D9482A] dark:text-[#FF8A6B]">
									View work
									<FaArrowRight
										className={`h-3 w-3 transition-transform group-hover:translate-x-0.5 ${card.external ? "-rotate-45" : ""}`}
									/>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<!-- Primary pathways -->
		<section>
			<div class="mb-6 flex flex-col items-start gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
				<h2 class="font-serif text-2xl sm:text-3xl font-semibold leading-tight">
					Explore
				</h2>
				<a
					href="/about"
					class="link shrink-0 text-sm no-underline hover:underline"
				>
					More about me
				</a>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				{
					pathways.map(({ Icon, title, body, links }) => (
						<article class="flex gap-4 rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-800 dark:bg-gray-900/40">
							<Icon className="mt-0.5 h-5 w-5 shrink-0 text-[#D9482A] dark:text-[#FF8A6B]" />
							<div class="min-w-0">
								<h3 class="font-serif text-lg font-semibold leading-snug text-gray-900 dark:text-gray-100">
									{title}
								</h3>
								<p class="mt-1.5 text-sm leading-6 text-gray-600 dark:text-gray-400">
									{body}
								</p>
								<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
									{links.map((link) => (
										<a href={link.href} class="link text-xs font-semibold no-underline hover:underline">
											{link.label}
										</a>
									))}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- Get in touch -->
		<section
			class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/40 px-6 py-8 sm:px-8 sm:flex sm:items-center sm:justify-between sm:gap-6"
		>
			<div>
				<h2 class="font-serif text-2xl font-semibold leading-tight">
					Get in touch
				</h2>
				<p class="mt-1.5 text-gray-600 dark:text-gray-400">
					I'm always up for collaborations in creative tools, education, and
					applied AI.
				</p>
			</div>
			<a
				href="/contact"
				class="mt-4 inline-flex shrink-0 items-center gap-2 rounded-lg bg-[#FF6B4A] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#E85530] sm:mt-0"
			>
				Contact me <FaArrowRight className="h-3 w-3" />
			</a>
		</section>
	</div>
</Layout>
