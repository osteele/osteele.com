---
import { loadProjectsFromTurtle } from "@/data/projects";
import CategoryLayout from "@/layouts/CategoryLayout.astro";

const { projects } = await loadProjectsFromTurtle();
const desktopProjects = projects.filter((project) => project.categories.includes("desktop-app"));
---

<CategoryLayout
  title="Desktop Apps"
  description="Native desktop applications for research, productivity, and creative work."
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Software", href: "/software" },
    { name: "Desktop Apps", href: "/software/desktop-apps" },
  ]}
  sections={[]}
  projects={desktopProjects}
  projectType="software"
  catchAllFirst={true}
  hideCatchAllTitle={true}
  relatedLinks={[
    { name: "Academic Research Tools", href: "/software/academic-research-tools" },
    { name: "Development Tools", href: "/software/development-tools" },
  ]}
/>
